# Abhängigkeiten
node_modules/

# Build-Ausgabe (Vite)
dist/
coverage/

# Umgebungsvariablen – niemals committen
.env
.env.*
!.env.example
!.env.ios-test.example
*.local

# Lokale Datensicherungen (z. B. Supabase-Export von family-main)
local-backups/

# Temporäre Vite-Dateien
vite.config.*.timestamp-*

# Lokale Vercel-Verknüpfung
.vercel/

# Betriebssystem
.DS_Store

# Capacitor iOS (Phase 7A): ios/ wird versioniert. Generierte bzw. lokale Teile ignoriert
# ios/.gitignore (Web-Kopie App/App/public, capacitor.config.json im Container, DerivedData,
# xcuserdata, Pods). Lokale Xcode-Benutzerdaten zusätzlich hier:
xcuserdata/
*.xcuserstate
DerivedData/

# Produktionspaket-Artefakte (Bootstrap-SQL, Dry-Run-Nachweise, Referenzen) – nie committen
local-release/
