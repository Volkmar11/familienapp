# Wochen Champion – Umgebungsvariablen (Vorlage, nur Platzhalter).
# Echte Werte gehören in .env.local (lokal, von Git ignoriert) bzw. in die
# Vercel-Umgebungsvariablen – niemals in das Repository.
# NIEMALS service_role-/Secret-Keys oder Datenbankpasswörter im Client verwenden.

# Backend-Modus: legacy (Standard, bestehende app_state-App) | family (neue Auth-/Familienarchitektur)
# Fehlt der Wert, gilt legacy. Produktion bleibt bis zur geplanten Umstellung auf legacy.
VITE_BACKEND_MODE=legacy

# LEGACY (bestehende Produktion, public.app_state)
VITE_SUPABASE_URL=https://<produktions-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-oder-anon-key-produktion>

# FAMILY (nur Testprojekt „wochen-champion-test“; darf nicht auf das Legacy-Projekt zeigen)
VITE_FAMILY_SUPABASE_URL=https://<test-ref>.supabase.co
VITE_FAMILY_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_…-des-testprojekts>

# Auth-/Link-Ziele (FAMILY). Leer lassen = aktuelle App-Herkunft (Web). Muss in Supabase
# unter Authentication → URL Configuration → Redirect URLs erlaubt sein.
VITE_AUTH_REDIRECT_URL=
# Einladungslinks: feste öffentliche Web-Domain (Pflicht für die spätere iOS-App)
VITE_INVITE_BASE_URL=
# Spätere iOS-App (Capacitor): Universal Link bzw. Deep Link für Auth-Mails – noch nicht festgelegt
VITE_NATIVE_AUTH_REDIRECT_URL=

# Rechtliches (FAMILY): öffentlich ohne Login erreichbar, nur https:// (Support auch mailto:)
# Vor Produktion/App Store Pflicht (scripts/check-release-readiness.mjs prüft das).
VITE_PRIVACY_URL=
VITE_IMPRINT_URL=
VITE_SUPPORT_URL=
