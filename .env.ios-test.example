# Wochen Champion – nativer iOS-TEST-Build (Phase 7A). Vorlage, nur Platzhalter.
# Kopieren nach .env.ios-test.local (von Git ignoriert) und dort echte TEST-Werte eintragen:
#   cp .env.ios-test.example .env.ios-test.local
# Verwendet von: npm run build:ios:test  (vite build --mode ios-test)
#
# Regeln (werden beim Build erzwungen, siehe scripts/lib/iosTestGuard.mjs):
#   • ausschließlich Testprojekt „wochen-champion-test“ – die Produktions-Ref bricht den Build ab
#   • nur der Publishable Key (sb_publishable_…), NIEMALS Secret-/service_role-Keys
#   • nur https:// (Support zusätzlich mailto:), keine Produktions-Web-Domain
#   • Vite bettet ALLE VITE_-Werte ins Bundle ein → LEGACY-Werte müssen hier leer überschrieben werden,
#     falls .env/.env.local sie für die Web-Entwicklung enthalten.

VITE_BACKEND_MODE=family

# Testprojekt (Supabase → Project Settings → API). Nur URL + Publishable Key.
VITE_FAMILY_SUPABASE_URL=https://<test-ref>.supabase.co
VITE_FAMILY_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_…-des-testprojekts>

# LEGACY bewusst leer (überschreibt evtl. Werte aus .env/.env.local)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Link-Ziele für den Test (optional). Nativ werden Auth-Mails über VITE_NATIVE_AUTH_REDIRECT_URL
# gesteuert (erst Phase 7B, bis dahin leer → Supabase Site URL des Testprojekts).
VITE_AUTH_REDIRECT_URL=
# Einladungslinks aus der App: öffentliche TEST-Web-Adresse, z. B. die Vercel-Preview von feature/appstore-v1.
# Leer = die App zeigt nur den Einladungscode (Code-Eingabe funktioniert immer).
VITE_INVITE_BASE_URL=
VITE_NATIVE_AUTH_REDIRECT_URL=

# Rechtliches (optional im Test; Pflicht vor App Store)
VITE_PRIVACY_URL=
VITE_IMPRINT_URL=
VITE_SUPPORT_URL=
